{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["RUN_RUNTIME_SECURITY_TESTS"]
    },
    "@sms/db#test": {
      "dependsOn": ["^build"],
      "env": ["RUN_RUNTIME_SECURITY_TESTS"]
    },
    "@sms/api#test": {
      "dependsOn": ["^build"],
      "env": ["RUN_RUNTIME_SECURITY_TESTS"]
    },
    "@sms/worker#test": {
      "dependsOn": ["^build"],
      "env": ["RUN_RUNTIME_SECURITY_TESTS"]
    }
  }
}