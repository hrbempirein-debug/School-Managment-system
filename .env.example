# ── Application ────────────────────────────────────────────────
NODE_ENV=development
APP_NAME=School Management SaaS
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000
LOG_LEVEL=info
# change in every real environment; used to sign request correlation values
SESSION_PEPPER=replace-me-with-long-random-string

# ── API server ─────────────────────────────────────────────────
API_PORT=4000
API_HOST=127.0.0.1
# trust proxy hop count when behind reverse proxy (0 local, 1 behind LB)
TRUST_PROXY=0

# ── Web (Next.js) ──────────────────────────────────────────────
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# ── PostgreSQL (VERIFIED server listening on :5432; credentials NOT verified) ──
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/school_saas_dev?schema=public
# separate roles: migrations run as migrator, runtime as app_rw
DATABASE_URL_MIGRATOR=postgresql://migrator:PASSWORD@localhost:5432/school_saas_dev
DATABASE_URL_APP=postgresql://app_rw:PASSWORD@localhost:5432/school_saas_dev
DB_POOL_MAX=10

# ── Redis (queues + cache + sessions) ──────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ── Auth / security ────────────────────────────────────────────
SESSION_TTL_IDLE_MINUTES=120
SESSION_TTL_ABSOLUTE_MINUTES=720
SESSION_COOKIE_NAME=sid
# AES-256-GCM master key for encrypting MFA secrets etc. (32 bytes, base64) — generate per env
APP_ENCRYPTION_KEY=
PASSWORD_ARGON2_M=65536
PASSWORD_ARGON2_T=3
PASSWORD_ARGON2_P=4

# ── Object storage (ADR-009) — S3-compatible or dev FS adapter ─
STORAGE_DRIVER=fs            # fs | s3
STORAGE_FS_ROOT=.data/storage
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
FILE_PRESIGN_PUT_TTL_SECONDS=900
FILE_PRESIGN_GET_TTL_SECONDS=600

# ── Billing provider (ADR-007) — none in dev; manual provider default ──
BILLING_PROVIDER=manual      # manual | stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Communication providers (Phase 8; adapters log to console in dev) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=

# ── AI / LLM (Phase 12) ───────────────────────────────────────
LLM_PROVIDER=                # openai | anthropic | ollama | …
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# ── Feature / platform defaults ────────────────────────────────
PLATFORM_ADMIN_EMAIL=        # seeded platform owner (dev only)
TRIAL_DAYS=14
DEFAULT_CURRENCY=USD
DEFAULT_LOCALE=en
DEFAULT_TIMEZONE=UTC

# ── Observability (optional until configured) ──────────────────
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
METRICS_PORT=9100
