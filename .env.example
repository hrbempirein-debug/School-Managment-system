# ── Application ────────────────────────────────────────────────
NODE_ENV=development
APP_NAME=School Management SaaS
LOG_LEVEL=info
# RESERVED / UNUSED. Declared in packages/config but read by nothing today.
# Intended for AES-256-GCM encryption of third-party/OAuth secrets in
# auth_identities.secret_enc, which is itself never written. Session tokens and
# password hashes are HASHED (sha256/argon2id), not encrypted. Leave empty until
# that feature is implemented — setting it enables nothing.
APP_ENCRYPTION_KEY=
# long random string used to pepper session tokens & password derivation
SESSION_PEPPER=

# ── API server ─────────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=4100
WEB_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4100

# ── Web (Next.js) ──────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:4100

# ── PostgreSQL: roles & databases created by scripts/bootstrap.sql ──
DATABASE_URL_MIGRATOR=postgresql://school_migrator:your_migrator_password@127.0.0.1:5432/school_saas_dev
DATABASE_URL_APP=postgresql://school_app_rw:your_app_password@127.0.0.1:5432/school_saas_dev
DATABASE_URL_TEST=postgresql://school_app_rw:your_app_password@127.0.0.1:5432/school_saas_test
DB_POOL_MAX=10

# ── Redis ──────────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379

# ── Auth / sessions ────────────────────────────────────────────
SESSION_COOKIE_NAME=sid
SESSION_TTL_ABSOLUTE_MINUTES=720
SESSION_TTL_IDLE_MINUTES=120
SESSION_MAX_SESSIONS=5
# Argon2id cost (OOM-safe for tests)
PASSWORD_MEMORY_COST_KB=65536
PASSWORD_TIME_COST=3
PASSWORD_PARALLELISM=4

# ── Rate limiting ──────────────────────────────────────────────
RATE_LOGIN_POINTS=20
RATE_LOGIN_DURATION_SECONDS=900
RATE_REGISTER_POINTS=5
RATE_REGISTER_DURATION_SECONDS=900
RATE_PERMISSIONS_POINTS=60
RATE_PERMISSIONS_DURATION_SECONDS=60

# ── Storage (ADR-009) ──────────────────────────────────────────
STORAGE_DRIVER=fs            # fs | s3
STORAGE_FS_ROOT=.data/storage
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
FILE_PRESIGN_PUT_TTL_SECONDS=900
FILE_PRESIGN_GET_TTL_SECONDS=600

# ── Platform admin (seeded once; dev only) ─────────────────────
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=     # min 12 chars; seeded by db:seed

# ── Billing (Phase 7; manual in dev) ───────────────────────────
BILLING_PROVIDER=manual      # manual | stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Communication (Phase 8; console/log adapters in dev) ───────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=

# ── AI (Phase 12) ──────────────────────────────────────────────
LI_ML_PROVIDER=
AI_API_KEY=
AI_MODEL=
